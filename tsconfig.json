{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"declaration": true,
		"noEmit": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedDeclarations": true,
		"strict": true,
		"skipLibCheck": true
	}
}
